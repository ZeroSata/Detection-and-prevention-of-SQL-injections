# =============================================================================
# DB Security Lab — расширенное журналирование PostgreSQL.
# В Docker Compose те же параметры задаются флагами `command:` в
# docker-compose.yml (см. сервис postgres). Этот файл — для локального запуска
# без Docker: подключите его в postgresql.conf (include) или допишите параметры.
# Режим журналирования: stderr (в Docker уходит в `docker logs lab-postgres`).
# =============================================================================

# Все DML/DDL-операторы попадают в журнал — позволяет видеть на стороне СУБД
# фактические (инъецированные) тексты запросов.
log_statement = 'mod'

# Подключения/отключения: видно, под какой ролью и откуда приходит приложение.
log_connections = on
log_disconnections = on

# Медленные запросы: time-based SQLi (pg_sleep) проявляет себя здесь.
log_min_duration_statement = 200

# Текст запроса при ошибке >= ERROR (error-based инъекции, стэкинг).
log_min_error_statement = error

# Ожидания блокировок (аномалии конкурентности).
log_lock_waits = on

# Контрольные точки (фоновая активность СУБД).
log_checkpoints = on

# Префикс строки: время, pid, база, пользователь, application_name, клиент.
log_line_prefix = '%m [%p] db=%d,user=%u,app=%a,client=%h '

# Уровень детализации ошибок приложения.
log_error_verbosity = default
