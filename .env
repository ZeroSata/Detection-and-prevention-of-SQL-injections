# =============================================================================
# DB Security Lab — пример файла окружения. Скопируйте в .env и поменяйте
# значения ПЕРЕД запуском вне локальной лаборатории.
#   cp .env.example .env
# ВНИМАНИЕ: значения по умолчанию — только для учебного стенда изолированно.
# =============================================================================

# --- PostgreSQL (контейнер + роли) ---
POSTGRES_DB=securedemo
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=app_admin
POSTGRES_ADMIN_PASSWORD=admin_change_me
APP_READONLY_PASSWORD=readonly_change_me
APP_LOGGER_PASSWORD=logger_change_me

# --- Порты сервисов ---
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Приложение ---
WAF_DEFAULT_ENABLED=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Пороги корреляции инцидентов ---
CORR_WINDOW_MINUTES=5
CORR_HIGH_THRESHOLD=3
CORR_CRITICAL_THRESHOLD=10
